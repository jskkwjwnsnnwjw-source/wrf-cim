&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_year = 2024,
 start_month = 1,
 start_day = 15,
 start_hour = 12,
 start_minute = 0,
 start_second = 0,
 end_year = 2024,
 end_month = 1,
 end_day = 16,
 end_hour = 12,
 end_minute = 0,
 end_second = 0,
 interval_seconds = 10800,
 io_form_geogrid = 2,
 opt_output_from_geogrid_path = '/wrf_run/geogrid_output/',
 debug_level = 0,
/

&geogrid
 parent_id = 1,
 parent_grid_ratio = 1,
 i_parent_start = 1,
 j_parent_start = 1,
 e_we = 1801,
 e_sn = 1401,
 geog_data_res = 'default',
 dx = 3000,
 dy = 3000,
 map_proj = 'lambert',
 ref_lat = -29.5,
 ref_lon = -56.0,
 truelat1 = -25.0,
 truelat2 = -33.0,
 stand_lon = -56.0,
 geog_data_path = '/opt/geog_data/',
 opt_geogrid_tbl_path = '/opt/WPS/ungrib/Variable_Tables/',
/

&metgrid
 parent_id = 1,
 parent_grid_ratio = 1,
 i_parent_start = 1,
 j_parent_start = 1,
 e_we = 1801,
 e_sn = 1401,
 dx = 3000,
 dy = 3000,
 opt_output_from_metgrid_path = '/wrf_run/metgrid_output/',
 opt_metgrid_tbl_path = '/opt/WPS/metgrid/',
 fg_name = './FILE:',
 rdincr = 3000,
/
