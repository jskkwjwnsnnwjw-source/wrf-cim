&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2000-01-01_00:00:00',
 end_date = '2000-01-02_00:00:00',
 interval_seconds = 21600,
 io_form_geogrid = 2,
 opt_output_from_geogrid_path = '/tmp/geogrid_output/',
 debug_level = 0,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 1801,
 e_sn              = 1401,
 geog_data_res     = 'default',
 dx                = 3000,
 dy                = 3000,
 map_proj          = 'lambert',
 lat1              = -25.0,
 lat2              = -33.0,
 ref_lat           = -29.5,
 ref_lon           = -56.0,
 truelat1          = -25.0,
 truelat2          = -33.0,
 stand_lon         = -56.0,
 geog_data_path    = '/data/geog/',
/

&metgrid
 fg_name = '/tmp/metgrid_input/',
 io_form_metgrid = 2,
 opt_output_from_metgrid_path = '/tmp/metgrid_output/',
 metgrid_table_input = '/tmp/WPS/metgrid.TBL',
/
